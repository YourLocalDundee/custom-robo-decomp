+# Game objects (game/ in splits.txt: decomp/src/game, tools/promote_drafts.py, one function per object; plan.md step 58)
+# are all linked from C unless CR_NOT_MATCHING names one: tools/gen_dtk_splits.py only splits a game object for a file
+# in decomp/src/game, and batch 9 checks each is 100% in objdiff with the retail SHA-1.
+def cr_matching(name: str) -> bool:
+    return name in CR_MATCHING or (name.startswith("game/") and name not in CR_NOT_MATCHING)
+
+
+def cr_object(name: str) -> Object:
+    extra = list(CR_OBJECT_CFLAGS.get(name, []))
+    for d, f in CR_DIR_CFLAGS.items():
+        if name.startswith(d):
+            extra += f
+    opts: Dict[str, Any] = {"extra_cflags": extra}
+    if name in CR_OBJECT_INCLUDES:
+        _, lib_cflags = CR_LIBS[name.split("/")[0]]
+        opts["cflags"] = [f for f in lib_cflags if not f.startswith("-i ")] + CR_OBJECT_INCLUDES[name]
+    return Object(Matching if cr_matching(name) else NonMatching, name, **opts)
+
+
+def libs_from_splits(path: Path) -> List[Dict[str, Any]]:
+    libs: Dict[str, Dict[str, Any]] = {}
+    names = set()
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if not line or line[0].isspace() or line.startswith("Sections:") or line.startswith("//"):
+            continue
+        name = line.split(":")[0].strip()
+        names.add(name)
+        top = name.split("/")[0]
+        mw_version, cflags = CR_LIBS.get(top, (config.linker_version, cflags_runtime))
+        lib = libs.setdefault(top, {
+            "lib": top,
+            "mw_version": mw_version,
+            "cflags": cflags,
+            "progress_category": "game" if top in GAME_DIRS else "sdk",
+            "objects": [],
+        })
+        lib["objects"].append(cr_object(name))
+    unknown = sorted(set(CR_MATCHING) - names)
+    if unknown:
+        sys.exit(f"CR_MATCHING names objects that are not in splits.txt: {unknown}")
+    return list(libs.values())
+
+
+config.libs = libs_from_splits(Path("config") / config.version / "splits.txt")
+config.reconfig_deps.append(Path("config") / config.version / "splits.txt")
 
 
