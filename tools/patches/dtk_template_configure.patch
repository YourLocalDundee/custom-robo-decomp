+
+# Custom Robo: one lib per top-level folder of the objects in splits.txt, in splits.txt order. Every object is
+# NonMatching (the build links dtk's split objects, which gives the retail main.dol); objects move to Matching here
+# when their C matches (Milestone 4 / 5). Library folders count as "sdk" progress, game/ as "game".
+GAME_DIRS = ("game",)
+
+
+def libs_from_splits(path: Path) -> List[Dict[str, Any]]:
+    libs: Dict[str, Dict[str, Any]] = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if not line or line[0].isspace() or line.startswith("Sections:") or line.startswith("//"):
+            continue
+        name = line.split(":")[0].strip()
+        top = name.split("/")[0]
+        lib = libs.setdefault(top, {
+            "lib": top,
+            "mw_version": config.linker_version,
+            "cflags": cflags_base if top in GAME_DIRS else cflags_runtime,
+            "progress_category": "game" if top in GAME_DIRS else "sdk",
+            "objects": [],
+        })
+        lib["objects"].append(Object(NonMatching, name))
+    return list(libs.values())
+
+
+config.libs = libs_from_splits(Path("config") / config.version / "splits.txt")
+config.reconfig_deps.append(Path("config") / config.version / "splits.txt")
 
 
