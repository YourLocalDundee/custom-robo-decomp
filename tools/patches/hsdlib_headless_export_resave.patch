@@ -0,0 +1,840 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Numerics;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Text.RegularExpressions;
+using HSDRaw;
+using HSDRaw.Common;
+using HSDRaw.GX;
+using HSDRaw.Tools;
+using HSDRawViewer.Converters;
+using HSDRawViewer.IO.GLTF;
+using HSDRawViewer.Tools.Animation;
+using IONET.Core;
+using IONET.Core.Model;
+using IONET.Core.Skeleton;
+using SharpGLTF.Schema2;
+using SixLabors.ImageSharp;
+using SixLabors.ImageSharp.PixelFormats;
+
+namespace HSDRawViewer
+{
+    /// <summary>
+    /// gameTesting patch: headless "import over" of an edited glb into a template .dat (docs/MODDING.md "Blender loop").
+    ///
+    ///   HSDRawViewer.exe --import &lt;template.dat&gt; &lt;edited.glb&gt; &lt;out.dat&gt; [--replace] [--skeleton template|glb]
+    ///                    [--roles &lt;roles_by_name.json&gt;] [--envelope-joint JOBJ_n]
+    ///
+    /// The glb is one that --export wrote from the template (bones JOBJ_n, meshes Joint_j_Object_d), edited in Blender.
+    ///
+    /// Skeleton
+    ///  --skeleton template (default): the glb must have exactly the template's joints JOBJ_0..n-1 with the same
+    ///      parents; every bone transform comes from the template.
+    ///  --skeleton glb: the joint tree is the glb's (the subtree of the bone JOBJ_0). A bone named JOBJ_n reuses
+    ///      template joint n (its flags, IK settings, robjs, rotation and scale); a bone moved by more than 0.001 gets
+    ///      its translation (and its inverse bind matrix) moved; a bone with any other name is a new joint, axis-aligned
+    ///      in world space at its head. Template joints absent from the glb are dropped with their DObjs. Children are
+    ///      ordered template joints first (by template number), then new bones by name; the result is numbered in
+    ///      pre-order, as HSDRawViewer's JOBJ_n.
+    ///
+    /// Meshes
+    ///  - named Joint_j_Object_d (the exporter's names) with the template's geometry: the template DObj is kept; its
+    ///    base colour texture / colour edits are applied (see ApplyTexture / ApplyColour).
+    ///  - same name, different geometry: without --replace a warning (geometry edits ignored, the step 70 behaviour);
+    ///    with --replace the template DObj is dropped and the mesh is imported as new geometry in its place.
+    ///  - with --replace, template DObjs that are not in the glb are dropped.
+    ///  - any other mesh is new geometry. A triangle whose three vertices are 100% on one bone becomes part of a rigid
+    ///    DObj on that joint (vertices in the joint's space); any other triangle goes to an envelope (smooth skinned)
+    ///    DObj on the envelope joint (default: the template's ENVELOPE_MODEL joint, else JOBJ_1 / JOBJ_0), vertices in
+    ///    the bind pose, up to 4 weights each in 0.1 steps (single-weight vertices in their joint's space only when the
+    ///    envelope joint has SKELETON / SKELETON_ROOT, as HSD and HSDRawViewer's exporter read them); every joint
+    ///    used by an envelope gets an inverse bind matrix and the SKELETON flag.
+    ///  - one DObj per (joint, material); the DObjs of one material share its MObj (Ray 01's 18 DObjs share one).
+    ///
+    /// Materials of new geometry
+    ///  - with a base colour image: a copy of the template's textured MObj (render mode, colours, every TObj field),
+    ///    the diffuse TObj's image replaced by the glb image encoded in the template TObj's format (CMP for robos), the
+    ///    specular TObj's image by a half-size specular mask made from it (luminance x (0.25 + 0.75 x metallic)).
+    ///    UVs: TEXCOORD_0 for every texture stage (TEX0 and TEX1 share one buffer, as in the game's bodies).
+    ///  - without an image: the template's render mode without textures, diffuse = base colour (the step 70 material).
+    ///  - glTF doubleSided material: no culling; single-sided: CULLFRONT with reversed winding (the game's own bodies).
+    ///
+    /// --roles: a roles file with bone NAMES ({"B_material_joint": "JOBJ_1", "C": {"head": "JOBJ_32", ...}}) is written
+    ///   next to out.dat as &lt;out&gt;.roles.json with the output joint numbers (tools/make_mod.py reads it).
+    /// Prints "import: ..." lines and a summary; exit code 1 on any error.
+    /// </summary>
+    public static class ModelImport
+    {
+        private static readonly Regex ExportedMesh = new(@"^Joint_(\d+)_Object_(\d+)");
+        private static readonly Regex BoneName = new(@"^JOBJ_(\d+)$");
+
+        private class Options
+        {
+            public bool Replace;
+            public bool GlbSkeleton;
+            public string Roles;
+            public string EnvelopeJoint;
+        }
+
+        public static int Run(string templatePath, string glbPath, string outPath, string[] extra = null)
+        {
+            try
+            {
+                var o = new Options();
+                extra ??= Array.Empty<string>();
+                for (int i = 0; i < extra.Length; i++)
+                {
+                    switch (extra[i])
+                    {
+                        case "--replace": o.Replace = true; break;
+                        case "--skeleton" when i + 1 < extra.Length:
+                            o.GlbSkeleton = extra[++i] switch { "glb" => true, "template" => false, var s => throw new ImportError($"--skeleton {s}: template or glb") };
+                            break;
+                        case "--roles" when i + 1 < extra.Length: o.Roles = extra[++i]; break;
+                        case "--envelope-joint" when i + 1 < extra.Length: o.EnvelopeJoint = extra[++i]; break;
+                        default: throw new ImportError($"unknown option {extra[i]}");
+                    }
+                }
+                Import(templatePath, glbPath, outPath, o);
+                return 0;
+            }
+            catch (ImportError e)
+            {
+                Console.WriteLine($"import: ERROR {e.Message}");
+                return 1;
+            }
+        }
+
+        private class ImportError : Exception { public ImportError(string m) : base(m) { } }
+
+        /// <summary>A joint of the output tree: its JOBJ, its bind-pose world matrix (the glb's vertex space).</summary>
+        private class Joint
+        {
+            public HSD_JOBJ J;
+            public Matrix4x4 W;
+            public int Template = -1;   // template joint number, -1 = new
+            public string Name;
+            public bool New => Template < 0;
+        }
+
+        private class MatInfo
+        {
+            public string Name;
+            public HSD_Image Diffuse, Specular;
+            public HSD_MOBJ Mobj;     // shared by every DObj of this material, as the game's bodies share theirs
+            public bool DoubleSided;
+            public Vector4 Colour;
+        }
+
+        private static void Import(string templatePath, string glbPath, string outPath, Options opt)
+        {
+            var dat = new HSDRawFile(templatePath);
+            var rootNode = dat.Roots.Find(r => r.Name.EndsWith("_joint"))
+                ?? throw new ImportError($"{templatePath}: no *_joint root");
+            if (dat.Roots.Count(r => r.Name.EndsWith("_joint")) != 1)
+                throw new ImportError($"{templatePath}: more than one *_joint root (not supported)");
+            var root = new HSD_JOBJ { _s = rootNode.Data._s };
+            List<HSD_JOBJ> tjoints = root.TreeList;   // pre-order = the exporter's JOBJ_n numbering
+            var tindex = new Dictionary<HSDStruct, int>();
+            for (int i = 0; i < tjoints.Count; i++) tindex[tjoints[i]._s] = i;
+            var tparents = new int[tjoints.Count];
+            tparents[0] = -1;
+            foreach (var j in tjoints)
+                foreach (var c in j.Children) tparents[tindex[c._s]] = tindex[j._s];
+
+            // the template as --export writes it: its bone world matrices are the space of the glb's vertices (the bind
+            // pose: inverse bind matrices where the joint has one, else the joint SRT), its meshes the originals
+            var exp = new ModelExporter(root, new ModelExportSettings { ExportTextures = false, Directory = Path.GetTempPath() }, new JointMap());
+            var tworlds = TemplateWorlds(exp.Scene.Models[0], tjoints.Count);
+            var original = exp.Scene.Models[0].Meshes.ToDictionary(m => m.Name, m => m);
+            float size = ModelSize(exp.Scene.Models[0]);
+
+            // template DObjs by the exporter's (joint, index) names, and the material template (the first textured MObj)
+            var dobjs = new Dictionary<(int, int), HSD_DOBJ>();
+            HSD_MOBJ texTemplate = null;
+            for (int i = 0; i < tjoints.Count; i++)
+            {
+                if (tjoints[i].Dobj == null) continue;
+                int d = 0;
+                foreach (var dobj in tjoints[i].Dobj.List)
+                {
+                    dobjs[(i, d++)] = dobj;
+                    if (texTemplate == null && dobj.Mobj != null && BaseColourTObj(dobj.Mobj) != null) texTemplate = dobj.Mobj;
+                }
+            }
+            var flatTemplate = dobjs.Values.FirstOrDefault()?.Mobj;
+            int envTemplate = tjoints.FindIndex(j => j.Flags.HasFlag(JOBJ_FLAG.ENVELOPE_MODEL));
+
+            // 1. glb
+            var scene = GLTFModelImporter.Import(glbPath, out _);
+            var gltf = ModelRoot.Load(glbPath);
+            var model = scene.Models[0];
+
+            // 2. skeleton
+            List<Joint> joints;
+            if (opt.GlbSkeleton)
+                joints = GlbSkeleton(model, root, tjoints, tparents, tworlds);
+            else
+            {
+                CheckSkeleton(model, tjoints.Count, tparents, tworlds);
+                joints = tjoints.Select((j, i) => new Joint { J = j, W = tworlds[i], Template = i, Name = $"JOBJ_{i}" }).ToList();
+            }
+            var byName = joints.ToDictionary(j => j.Name, j => j);
+            var byTemplate = joints.Where(j => !j.New).ToDictionary(j => j.Template, j => j);
+            var outIndex = new Dictionary<HSDStruct, int>();
+            for (int i = 0; i < joints.Count; i++) outIndex[joints[i].J._s] = i;
+
+            Joint envJoint;
+            if (opt.EnvelopeJoint != null)
+                envJoint = byName.GetValueOrDefault(opt.EnvelopeJoint) ?? throw new ImportError($"--envelope-joint {opt.EnvelopeJoint}: no such bone");
+            else
+                envJoint = (envTemplate >= 0 ? byTemplate.GetValueOrDefault(envTemplate) : null) ?? byTemplate.GetValueOrDefault(1) ?? joints[0];
+
+            bool envLocal = (envJoint.J.Flags & (JOBJ_FLAG.SKELETON | JOBJ_FLAG.SKELETON_ROOT)) != 0;
+            var touched = new HashSet<HSDStruct>();
+            var removed = new HashSet<HSDStruct>();          // template DObjs to drop
+            var newMats = new Dictionary<string, HSD_MOBJ>(); // flat materials (shared, step 70)
+            var texMats = new Dictionary<string, MatInfo>();
+            var doneMobjs = new Dictionary<HSDStruct, string>();
+            int existing = 0, newMeshes = 0, newTris = 0, textures = 0, colours = 0, replaced = 0;
+            var seenExisting = new HashSet<(int, int)>();
+            // new geometry: rigid groups (joint, material) and envelope groups (material); triangles as vertex lists
+            var rigid = new SortedDictionary<(int, string), List<GX_Vertex>>();
+            var env = new SortedDictionary<string, (List<GX_Vertex> v, List<HSD_JOBJ[]> b, List<float[]> w)>(StringComparer.Ordinal);
+            var groupMeshes = new Dictionary<string, SortedSet<string>>();
+            var enveloped = new HashSet<int>();
+            bool anyUV = false;
+
+            foreach (var mesh in model.Meshes)
+            {
+                var m = ExportedMesh.Match(mesh.Name);
+                if (m.Success && dobjs.TryGetValue((int.Parse(m.Groups[1].Value), int.Parse(m.Groups[2].Value)), out var dobj))
+                {
+                    var key = (int.Parse(m.Groups[1].Value), int.Parse(m.Groups[2].Value));
+                    string baseName = mesh.Name.Split('.')[0];
+                    bool same = !original.TryGetValue(baseName, out var orig) || SameGeometry(orig, mesh, size, out string why0);
+                    bool jointKept = byTemplate.ContainsKey(key.Item1);
+                    if (same && jointKept)
+                    {
+                        // 3a. a template mesh: kept, material edits only
+                        existing++;
+                        seenExisting.Add(key);
+                        if (opt.GlbSkeleton && byTemplate[key.Item1].W != tworlds[key.Item1])
+                            Console.WriteLine($"import: warning: {mesh.Name}: its joint JOBJ_{key.Item1} moved; the kept template mesh moves with it");
+                        foreach (var matName in mesh.Polygons.Select(p => p.MaterialName).Distinct())
+                        {
+                            var mat = gltf.LogicalMaterials.FirstOrDefault(x => x.Name == matName);
+                            if (mat == null || dobj.Mobj == null) continue;
+                            if (doneMobjs.TryGetValue(dobj.Mobj._s, out string prev))
+                            {
+                                if (prev != matName)
+                                    Console.WriteLine($"import: warning: {mesh.Name}: material {matName} shares a template material with {prev}; the first one's edits win");
+                                continue;
+                            }
+                            doneMobjs[dobj.Mobj._s] = matName;
+                            if (ApplyTexture(mat, dobj.Mobj, mesh.Name)) textures++;
+                            if (ApplyColour(mat, dobj.Mobj, mesh.Name)) colours++;
+                        }
+                        continue;
+                    }
+                    if (!opt.Replace)
+                    {
+                        if (!jointKept) throw new ImportError($"{mesh.Name}: its joint JOBJ_{key.Item1} is not in the glb skeleton (use --replace to re-import it)");
+                        SameGeometry(orig, mesh, size, out string why);
+                        Console.WriteLine($"import: warning: {mesh.Name}: geometry differs from the template ({why}); geometry edits to existing meshes are not imported without --replace, only material / texture edits");
+                        existing++;
+                        seenExisting.Add(key);
+                        continue;
+                    }
+                    // 3b. --replace: the template DObj goes, the mesh comes in as new geometry
+                    replaced++;
+                    Console.WriteLine($"import: {mesh.Name} replaces the template's DObj (geometry changed)");
+                }
+
+                // 3c. new geometry
+                newMeshes++;
+                foreach (var poly in mesh.Polygons)
+                {
+                    if (poly.Indicies.Count == 0) continue;
+                    poly.ToTriangles(mesh);
+                    if (poly.PrimitiveType != IOPrimitive.TRIANGLE)
+                        throw new ImportError($"{mesh.Name}: primitive {poly.PrimitiveType} not supported");
+                    string matName = poly.MaterialName ?? "";
+                    var info = Material(matName, gltf, texTemplate, texMats);
+                    bool textured = info.Diffuse != null;
+                    if (textured && !mesh.HasUVSet(0))
+                        throw new ImportError($"{mesh.Name}: material {matName} has a texture but the mesh has no UVs");
+                    if (!groupMeshes.TryGetValue(matName, out var gm)) groupMeshes[matName] = gm = new SortedSet<string>();
+                    gm.Add(mesh.Name);
+                    for (int t = 0; t + 2 < poly.Indicies.Count; t += 3)
+                    {
+                        var tri = new[] { poly.Indicies[t], poly.Indicies[t + 1], poly.Indicies[t + 2] };
+                        var ws = tri.Select(vi => Weights(mesh, mesh.Vertices[vi], byName)).ToArray();
+                        bool isRigid = ws.All(w => w.Length == 1) && ws.All(w => w[0].j == ws[0][0].j);
+                        // the importer's winding: reverse each triangle (ModelImporter's FlipWindingOrder default)
+                        if (isRigid)
+                        {
+                            var jt = ws[0][0].j;
+                            int ji = outIndex[jt.J._s];
+                            if (!rigid.TryGetValue((ji, matName), out var list)) rigid[(ji, matName)] = list = new List<GX_Vertex>();
+                            Matrix4x4.Invert(jt.W, out var inv);
+                            foreach (int vi in tri.Reverse())
+                                list.Add(Vertex(mesh.Vertices[vi], inv, textured));
+                        }
+                        else
+                        {
+                            if (!env.TryGetValue(matName, out var g)) env[matName] = g = (new List<GX_Vertex>(), new List<HSD_JOBJ[]>(), new List<float[]>());
+                            for (int k = 2; k >= 0; k--)
+                            {
+                                var w = ws[k];
+                                var inv = Matrix4x4.Identity;
+                                // a single 1.0 weight under a SKELETON / SKELETON_ROOT DObj joint is in its joint's space
+                                // (HSD; HSDRawViewer's exporter reads it so); under any other joint (Ray 01's J1) in the bind pose
+                                if (w.Length == 1 && envLocal) Matrix4x4.Invert(w[0].j.W, out inv);
+                                g.v.Add(Vertex(mesh.Vertices[tri[k]], inv, textured));
+                                g.b.Add(w.Select(x => x.j.J).ToArray());
+                                g.w.Add(w.Select(x => x.w).ToArray());
+                                foreach (var x in w) enveloped.Add(outIndex[x.j.J._s]);
+                            }
+                        }
+                        anyUV |= textured;
+                        newTris++;
+                    }
+                }
+            }
+
+            // 4. drop template DObjs (--replace: every template DObj not kept)
+            if (opt.Replace)
+                foreach (var (k, d) in dobjs)
+                    if (!seenExisting.Contains(k)) removed.Add(d._s);
+            foreach (var k in dobjs.Keys.Where(k => !seenExisting.Contains(k) && !opt.Replace))
+                Console.WriteLine($"import: warning: Joint_{k.Item1}_Object_{k.Item2} is not in the glb; kept unchanged (--replace drops it)");
+            foreach (var jt in joints)
+            {
+                if (jt.J.Dobj == null) continue;
+                var keep = jt.J.Dobj.List.Where(d => !removed.Contains(d._s)).ToList();
+                if (keep.Count == jt.J.Dobj.List.Count) continue;
+                touched.Add(jt.J._s);
+                jt.J.Dobj = null;
+                foreach (var d in keep) { d.Next = null; if (jt.J.Dobj == null) jt.J.Dobj = d; else jt.J.Dobj.Add(d); }
+            }
+            int dropped = removed.Count;
+
+            // 5. new DObjs
+            var gen = new POBJ_Generator();
+            var addedTo = new SortedDictionary<int, int>();
+            HSD_DOBJ AddDobj(Joint jt, string matName, Func<HSD_POBJ> makePobj, int tris, string kind)
+            {
+                var info = texMats[matName];
+                gen.CullMode = info.DoubleSided ? GenCullMode.None : GenCullMode.Front;
+                var d = new HSD_DOBJ
+                {
+                    Mobj = info.Diffuse != null ? (info.Mobj ??= TexturedMobj(texTemplate, info)) : NewMaterial(matName, gltf, flatTemplate, newMats),
+                    Pobj = makePobj(),
+                };
+                if (jt.J.Dobj == null) jt.J.Dobj = d; else jt.J.Dobj.Add(d);
+                touched.Add(jt.J._s);
+                int ji = outIndex[jt.J._s];
+                addedTo[ji] = addedTo.GetValueOrDefault(ji) + tris;
+                Console.WriteLine($"import: new {kind} DObj on JOBJ_{ji}: {tris} triangles, material {matName}{(info.Diffuse != null ? $" (texture {info.Diffuse.Width}x{info.Diffuse.Height} {info.Diffuse.Format})" : "")}{(info.DoubleSided ? ", two-sided" : "")}, from {string.Join(", ", groupMeshes[matName])}");
+                return d;
+            }
+            foreach (var ((ji, matName), verts) in rigid)
+            {
+                bool tex = texMats[matName].Diffuse != null;
+                var attrs = tex ? new[] { GXAttribName.GX_VA_POS, GXAttribName.GX_VA_NRM, GXAttribName.GX_VA_TEX0, GXAttribName.GX_VA_TEX1 }
+                                : new[] { GXAttribName.GX_VA_POS, GXAttribName.GX_VA_NRM };
+                AddDobj(joints[ji], matName, () => gen.CreatePOBJsFromTriangleList(verts, attrs, null), verts.Count / 3, "rigid");
+            }
+            foreach (var (matName, g) in env)
+            {
+                bool tex = texMats[matName].Diffuse != null;
+                var attrs = tex ? new[] { GXAttribName.GX_VA_PNMTXIDX, GXAttribName.GX_VA_POS, GXAttribName.GX_VA_NRM, GXAttribName.GX_VA_TEX0, GXAttribName.GX_VA_TEX1 }
+                                : new[] { GXAttribName.GX_VA_PNMTXIDX, GXAttribName.GX_VA_POS, GXAttribName.GX_VA_NRM };
+                AddDobj(envJoint, matName, () => gen.CreatePOBJsFromTriangleList(g.v, attrs, g.b, g.w), g.v.Count / 3, "envelope");
+            }
+
+            // 6. inverse binds + SKELETON for every joint an envelope uses (the bind pose the vertices are in)
+            foreach (int ji in enveloped)
+            {
+                var jt = joints[ji];
+                Matrix4x4.Invert(jt.W, out var inv);
+                jt.J.InverseWorldTransform = ToHsd(inv);
+                jt.J.Flags |= JOBJ_FLAG.SKELETON;
+            }
+
+            gen.SaveChanges();
+            UpdateFlags(root, joints, touched);
+
+            // 7. block B's joint must keep a material (the game reads jobj->dobj->mobj)
+            int bJoint = 1;
+            JsonObject roles = null;
+            if (opt.Roles != null)
+            {
+                roles = JsonNode.Parse(File.ReadAllText(opt.Roles))?.AsObject() ?? throw new ImportError($"{opt.Roles}: not a JSON object");
+                int Resolve(JsonNode n, string what)
+                {
+                    if (n == null) return -1;
+                    if (n.GetValueKind() == JsonValueKind.Number) return (int)n;
+                    string s = (string)n;
+                    var jt = byName.GetValueOrDefault(s) ?? throw new ImportError($"{opt.Roles}: {what} = {s}: no such bone in the glb skeleton");
+                    return outIndex[jt.J._s];
+                }
+                var outRoles = new JsonObject();
+                bJoint = Resolve(roles["B_material_joint"], "B_material_joint");
+                outRoles["B_material_joint"] = bJoint;
+                var c = new JsonObject();
+                foreach (var (k, v) in roles["C"]?.AsObject() ?? throw new ImportError($"{opt.Roles}: no C"))
+                {
+                    int n = Resolve(v, "C." + k);
+                    c[k] = n < 0 ? null : n;
+                }
+                outRoles["C"] = c;
+                outRoles["joints"] = new JsonArray(joints.Select(j => (JsonNode)j.Name).ToArray());   // output number -> glb bone name
+                foreach (var (k, v) in roles)
+                    if (k != "B_material_joint" && k != "C") outRoles[k] = v?.DeepClone();
+                string rolesOut = Path.ChangeExtension(outPath, ".roles.json");
+                File.WriteAllText(rolesOut, outRoles.ToJsonString(new JsonSerializerOptions { WriteIndented = true }) + "\n");
+                Console.WriteLine($"import: roles -> {rolesOut}: B {bJoint}, C " + string.Join(" ", c.Select(kv => $"{kv.Key}={kv.Value}")));
+            }
+            if (bJoint >= joints.Count || joints[bJoint].J.Dobj?.Mobj == null)
+                throw new ImportError($"block B's material joint JOBJ_{bJoint} has no DObj / material; the game reads its material (put a mesh on it, e.g. the envelope body)");
+
+            dat.Save(outPath);
+            Console.WriteLine($"import: {Path.GetFileName(glbPath)} -> {outPath} ({new FileInfo(outPath).Length} bytes): joints {joints.Count} " +
+                $"({(opt.GlbSkeleton ? $"glb skeleton, {joints.Count(j => j.New)} new, {tjoints.Count - joints.Count(j => !j.New)} dropped" : "template skeleton")}), " +
+                $"template meshes kept {existing} (textures replaced {textures}, colours changed {colours}), dropped {dropped} (replaced {replaced}), " +
+                $"new meshes {newMeshes} ({newTris} triangles; " + string.Join(", ", addedTo.Select(kv => $"JOBJ_{kv.Key}: {kv.Value}")) + $"), " +
+                $"materials {texMats.Count(m => m.Value.Diffuse != null)} textured / {newMats.Count} flat, enveloped joints {enveloped.Count}");
+        }
