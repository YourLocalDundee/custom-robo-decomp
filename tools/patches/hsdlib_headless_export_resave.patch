@@ -0,0 +1,101 @@
+using System;
+using System.Linq;
+using HSDRaw;
+using HSDRaw.Common;
+using HSDRaw.Common.Animation;
+
+namespace HSDRawViewer
+{
+    /// <summary>
+    /// gameTesting patch: print a model's joint tree, DObjs, materials, textures and animations without the GUI.
+    ///   HSDRawViewer.exe --info &lt;file.dat&gt;
+    /// </summary>
+    public static class ModelInfo
+    {
+        /// <summary>A struct's bytes in hex with its pointer slots shown as "pppppppp" (for field-by-field comparison).</summary>
+        public static string Raw(HSDStruct s)
+        {
+            if (s == null) return "-";
+            var d = s.GetData();
+            var sb = new System.Text.StringBuilder();
+            for (int o = 0; o + 4 <= d.Length; o += 4)
+                sb.Append(s.References.ContainsKey(o) ? "pppppppp" : $"{d[o]:x2}{d[o + 1]:x2}{d[o + 2]:x2}{d[o + 3]:x2}").Append(o + 4 < d.Length ? " " : "");
+            return sb.ToString();
+        }
+
+        public static int Run(string path)
+        {
+            var dat = new HSDRawFile(path);
+            foreach (var r in dat.Roots)
+            {
+                Console.WriteLine($"root {r.Name}");
+                if (r.Name == "cr_header2")
+                {
+                    var d = new HSD_JOBJDesc { _s = r.Data._s };
+                    Console.WriteLine($"  JOBJDesc: joint anims {d.JointAnimations?.Array.Length ?? 0}, material anims {d.MaterialAnimations?.Array.Length ?? 0}, shape anims {d.ShapeAnimations?.Array.Length ?? 0}");
+                    if (d.JointAnimations != null)
+                        foreach (var a in d.JointAnimations.Array)
+                        {
+                            var list = a.TreeList;
+                            int tracks = list.Sum(x => x.AOBJ?.FObjDesc?.List.Count ?? 0);
+                            Console.WriteLine($"    anim joint tree {list.Count} nodes, {list.Count(x => x.AOBJ != null)} with AOBJ, {tracks} tracks: " +
+                                string.Join(" ", list.Select((x, i) => (x, i)).Where(t => t.x.AOBJ != null).Select(t => $"{t.i}[{string.Join(",", t.x.AOBJ.FObjDesc?.List.Select(f => f.JointTrackType.ToString()) ?? new string[0])}] end {t.x.AOBJ.EndFrame}")));
+                        }
+                }
+                if (!r.Name.EndsWith("_joint")) continue;
+                var root = new HSD_JOBJ { _s = r.Data._s };
+                var joints = root.TreeList;
+                var idx = joints.Select((j, i) => (j, i)).ToDictionary(t => t.j._s, t => t.i);
+                int[] par = new int[joints.Count]; par[0] = -1;
+                foreach (var j in joints) foreach (var c in j.Children) par[idx[c._s]] = idx[j._s];
+                // world matrices from the joint SRTs (what the game computes without animation) vs. the inverse binds
+                var srt = new System.Numerics.Matrix4x4[joints.Count];
+                for (int i = 0; i < joints.Count; i++)
+                {
+                    var jj = joints[i];
+                    var b = new IONET.Core.Skeleton.IOBone { Scale = new System.Numerics.Vector3(jj.SX, jj.SY, jj.SZ), RotationEuler = new System.Numerics.Vector3(jj.RX, jj.RY, jj.RZ), Translation = new System.Numerics.Vector3(jj.TX, jj.TY, jj.TZ) };
+                    srt[i] = par[i] < 0 ? b.LocalTransform : b.LocalTransform * srt[par[i]];
+                }
+                for (int i = 0; i < joints.Count; i++)
+                {
+                    var j = joints[i];
+                    if (j.InverseWorldTransform != null)
+                    {
+                        var mat = j.InverseWorldTransform;
+                        var ibm = new System.Numerics.Matrix4x4(mat.M11, mat.M21, mat.M31, 0, mat.M12, mat.M22, mat.M32, 0, mat.M13, mat.M23, mat.M33, 0, mat.M14, mat.M24, mat.M34, 1);
+                        var prod = srt[i] * ibm;
+                        float e = 0;
+                        for (int rr = 0; rr < 4; rr++) for (int cc = 0; cc < 4; cc++) e = Math.Max(e, Math.Abs(prod[rr, cc] - (rr == cc ? 1 : 0)));
+                        Console.WriteLine($"  J{i} srt world x ibm: largest difference from identity {e:0.####}");
+                    }
+                    Console.WriteLine($"  J{i} p{par[i]} flags {j.Flags} T({j.TX:0.###},{j.TY:0.###},{j.TZ:0.###}) R({j.RX:0.###},{j.RY:0.###},{j.RZ:0.###}) S({j.SX:0.###},{j.SY:0.###},{j.SZ:0.###}) ibm {(j.InverseWorldTransform != null ? "yes" : "no")} robj {(j.ROBJ != null ? j.ROBJ.List.Count.ToString() : "-")}");
+                    if (j.ROBJ != null)
+                        foreach (var ro in j.ROBJ.List)
+                            Console.WriteLine($"     robj type {ro.RefType} limit {ro.LimitFlag} flags {ro.Flags:X8}");
+                    if (j.Dobj == null) continue;
+                    int d = 0;
+                    foreach (var dobj in j.Dobj.List)
+                    {
+                        var m = dobj.Mobj;
+                        Console.WriteLine($"     D{d++} mobj@{m?._s.GetHashCode():X} render {m?.RenderFlags} dif {m?.Material?.DIF_R},{m?.Material?.DIF_G},{m?.Material?.DIF_B} amb {m?.Material?.AMB_R},{m?.Material?.AMB_G},{m?.Material?.AMB_B} spc {m?.Material?.SPC_R} shin {m?.Material?.Shininess} pe {(m?.PEDesc != null ? "yes" : "no")}");
+                        Console.WriteLine($"       mobj raw {Raw(m?._s)} | material raw {Raw(m?.Material?._s)}");
+                        if (m?.Textures != null)
+                            foreach (var t in m.Textures.List)
+                            {
+                                Console.WriteLine($"       tobj flags {t.Flags} {t.ImageData?.Width}x{t.ImageData?.Height} {t.ImageData?.Format} wrap {t.WrapS}/{t.WrapT} rep {t.RepeatS}/{t.RepeatT} colorop {t.ColorOperation} alphaop {t.AlphaOperation} blend {t.Blending} coord {t.GXTexGenSrc} lod {(t.LOD != null ? "yes" : "no")} tev {(t.TEV != null ? "yes" : "no")} mag {t.MagFilter} S({t.SX},{t.SY},{t.SZ})");
+                                Console.WriteLine($"         tobj raw {Raw(t._s)} | image raw {Raw(t.ImageData?._s)}");
+                            }
+                        if (dobj.Pobj != null)
+                            foreach (var p in dobj.Pobj.List)
+                            {
+                                var env = p.EnvelopeWeights;
+                                Console.WriteLine($"       pobj flags {p.Flags} attrs {p.AttributesTypes} single {(p.SingleBoundJOBJ != null && idx.ContainsKey(p.SingleBoundJOBJ._s) ? "J" + idx[p.SingleBoundJOBJ._s] : "-")} envelopes {env?.Length ?? 0}" +
+                                    (env != null ? " " + string.Join(" ", env.Take(12).Select(e => "[" + string.Join("+", e.ToList().Select(w => $"J{(idx.TryGetValue(w.Item1._s, out int q) ? q : -1)}:{w.Item2:0.##}")) + "]")) : ""));
+                            }
+                    }
+                }
+            }
+            return 0;
+        }
+    }
+}
