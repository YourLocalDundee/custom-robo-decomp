+                BatchExport.Run(args[1], args[2], args[3..]);
+                return;
+            }
+            //   HSDRawViewer.exe --resave <in.dat> <out.dat>   (load + save: HSDLib rebuilds the layout)
+            if (args.Length == 3 && args[0] == "--resave")
+            {
+                new HSDRaw.HSDRawFile(args[1]).Save(args[2]);
+                System.Console.WriteLine($"resaved {args[1]} -> {args[2]}");
+                return;
+            }
+            //   HSDRawViewer.exe --info <file.dat>   (joints, DObjs, materials, textures, animations: ModelInfo.cs)
+            if (args.Length == 2 && args[0] == "--info")
+            {
+                System.Environment.ExitCode = ModelInfo.Run(args[1]);
+                return;
+            }
+            //   HSDRawViewer.exe --import <template.dat> <edited.glb> <out.dat>   (import over the template's joint tree, ModelImport.cs)
+            //   options: [--replace] [--skeleton template|glb] [--roles <roles_by_name.json>] [--envelope-joint JOBJ_n]
+            if (args.Length >= 4 && args[0] == "--import")
+            {
+                System.Environment.ExitCode = ModelImport.Run(args[1], args[2], args[3], args[4..]);
+                return;
+            }
             PluginManager.Init();
