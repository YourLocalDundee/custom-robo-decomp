+        /// <summary>The glb's joint tree (--skeleton glb), relinking the template's JOBJs it names and adding new ones.</summary>
+        private static List<Joint> GlbSkeleton(IOModel model, HSD_JOBJ root, List<HSD_JOBJ> tjoints, int[] tparents, Matrix4x4[] tworlds)
+        {
+            IOBone Find(IEnumerable<IOBone> bs)
+            {
+                foreach (var b in bs)
+                {
+                    if (b.Name == "JOBJ_0") return b;
+                    var r = Find(b.Children);
+                    if (r != null) return r;
+                }
+                return null;
+            }
+            var b0 = Find(model.Skeleton.RootBones) ?? throw new ImportError("the glb has no bone JOBJ_0 (the root joint must stay)");
+            var outJ = new List<Joint>();
+            var used = new HashSet<int>();
+            var names = new HashSet<string>();
+            int moved = 0;
+
+            Joint Make(IOBone b, Joint parent)
+            {
+                if (!names.Add(b.Name)) throw new ImportError($"bone {b.Name} appears twice");
+                var w = b.WorldTransform;
+                var p = w.Translation;
+                var jt = new Joint { Name = b.Name };
+                var m = BoneName.Match(b.Name);
+                if (m.Success && int.Parse(m.Groups[1].Value) < tjoints.Count)
+                {
+                    int n = int.Parse(m.Groups[1].Value);
+                    used.Add(n);
+                    jt.Template = n;
+                    jt.J = tjoints[n];
+                    jt.W = tworlds[n];
+                    bool reparented = parent == null ? n != 0 : parent.Template != tparents[n];
+                    if (Vector3.Distance(p, jt.W.Translation) > 1e-3f)
+                    {
+                        var nw = jt.W;
+                        nw.Translation = p;
+                        jt.W = nw;
+                        if (jt.J.InverseWorldTransform != null)
+                        {
+                            Matrix4x4.Invert(nw, out var inv);
+                            jt.J.InverseWorldTransform = ToHsd(inv);
+                        }
+                        moved++;
+                        reparented = true;
+                        Console.WriteLine($"import: bone {b.Name} moved to ({p.X:0.###}, {p.Y:0.###}, {p.Z:0.###})");
+                    }
+                    if (reparented && parent != null)
+                    {
+                        Matrix4x4.Invert(parent.W, out var pinv);
+                        SetLocal(jt.J, jt.W * pinv);
+                    }
+                }
+                else
+                {
+                    if (parent == null) throw new ImportError("the root bone must be JOBJ_0");
+                    jt.J = new HSD_JOBJ { SX = 1, SY = 1, SZ = 1, Flags = 0 };
+                    jt.W = Matrix4x4.CreateTranslation(p);
+                    Matrix4x4.Invert(parent.W, out var pinv);
+                    SetLocal(jt.J, jt.W * pinv);
+                    Console.WriteLine($"import: new bone {b.Name} under {parent.Name} at ({p.X:0.###}, {p.Y:0.###}, {p.Z:0.###})");
+                }
+                outJ.Add(jt);
+                var kids = b.Children.OrderBy(c =>
+                {
+                    var cm = BoneName.Match(c.Name);
+                    return cm.Success && int.Parse(cm.Groups[1].Value) < tjoints.Count ? int.Parse(cm.Groups[1].Value) : int.MaxValue;
+                }).ThenBy(c => c.Name, StringComparer.Ordinal).ToList();
+                var made = kids.Select(c => Make(c, jt).J).ToList();
+                // relink only what changed (unchanged links keep the template's byte layout)
+                if (jt.J.Child?._s != made.FirstOrDefault()?._s) jt.J.Child = made.FirstOrDefault();
+                for (int i = 0; i < made.Count; i++)
+                {
+                    var nx = i + 1 < made.Count ? made[i + 1] : null;
+                    if (made[i].Next?._s != nx?._s) made[i].Next = nx;
+                }
+                return jt;
+            }
+            var r0 = Make(b0, null);
+            if (r0.J.Next != null) r0.J.Next = null;
+            if (r0.J._s != root._s) throw new ImportError("internal: root changed");
+            var dropped = Enumerable.Range(0, tjoints.Count).Where(i => !used.Contains(i)).ToList();
+            // robjs that point at dropped joints
+            foreach (var jt in outJ)
+                if (jt.J.ROBJ != null)
+                    foreach (var ro in jt.J.ROBJ.List)
+                        if (ro.RefType == REFTYPE.JOBJ && ro._s.GetReference<HSD_JOBJ>(0x08) is HSD_JOBJ rj && !outJ.Any(o => o.J._s == rj._s))
+                            throw new ImportError($"{jt.Name}: its robj points at a dropped joint");
+            Console.WriteLine($"import: glb skeleton: {outJ.Count} joints ({outJ.Count(j => j.New)} new, {moved} moved, {dropped.Count} template joints dropped" +
+                (dropped.Count > 0 ? ": " + string.Join(", ", dropped.Take(12).Select(i => "JOBJ_" + i)) : "") + ")");
+            for (int i = 0; i < outJ.Count; i++)
+                if (outJ[i].Name != $"JOBJ_{i}")
+                    Console.WriteLine($"import:   joint {i} = {outJ[i].Name}");
+            return outJ;
+        }
+
+        /// <summary>Sets a JOBJ's SRT from a local matrix (rotation order X, Y, Z as HSD / the exporter use).</summary>
+        private static void SetLocal(HSD_JOBJ j, Matrix4x4 m)
+        {
+            Matrix4x4.Decompose(m, out var s, out var q, out var t);
+            var r = Matrix4x4.CreateFromQuaternion(q);
+            float ry = MathF.Asin(Math.Clamp(-r.M13, -1, 1));
+            float rx, rz;
+            if (MathF.Abs(r.M13) < 0.9999f) { rx = MathF.Atan2(r.M23, r.M33); rz = MathF.Atan2(r.M12, r.M11); }
+            else { rx = MathF.Atan2(-r.M32, r.M22); rz = 0; }
+            j.SX = s.X; j.SY = s.Y; j.SZ = s.Z;
+            j.RX = rx; j.RY = ry; j.RZ = rz;
+            j.TX = t.X; j.TY = t.Y; j.TZ = t.Z;
+            // check against the exporter's own composition (IONET)
+            var b = new IOBone { Scale = s, RotationEuler = new Vector3(rx, ry, rz), Translation = t };
+            var back = b.LocalTransform;
+            for (int i = 0; i < 4; i++)
+                for (int k = 0; k < 4; k++)
+                    if (MathF.Abs(back[i, k] - m[i, k]) > 1e-3f)
+                        throw new ImportError($"internal: joint transform does not round-trip ({i},{k}: {back[i, k]} vs {m[i, k]})");
+        }
+
+        private static HSD_Matrix4x3 ToHsd(Matrix4x4 m) => new()
+        {
+            M11 = m.M11, M21 = m.M12, M31 = m.M13,
+            M12 = m.M21, M22 = m.M22, M32 = m.M23,
+            M13 = m.M31, M23 = m.M32, M33 = m.M33,
+            M14 = m.M41, M24 = m.M42, M34 = m.M43,
+        };
+
+        /// <summary>A vertex's bone weights (normalised, at most 4, below 0.01 dropped); no weights = its mesh's parent bone.</summary>
+        private static (Joint j, float w)[] Weights(IOMesh mesh, IOVertex v, Dictionary<string, Joint> byName)
+        {
+            var ws = v.Envelope.Weights.Where(w => w.Weight > 0.01f).GroupBy(w => w.BoneName)
+                .Select(g => (name: g.Key, w: g.Sum(x => x.Weight))).OrderByDescending(x => x.w).Take(4).ToList();
+            if (ws.Count == 0)
+            {
+                string pn = mesh.ParentBone?.Name;
+                if (pn == null || !byName.ContainsKey(pn))
+                    throw new ImportError($"{mesh.Name}: vertices with no bone weights; weight new geometry to the skeleton's bones (vertex groups named after bones)");
+                ws.Add((pn, 1));
+            }
+            float sum = ws.Sum(x => x.w);
+            var r = ws.Select(x => (byName.GetValueOrDefault(x.name) ?? throw new ImportError($"{mesh.Name}: bone {x.name} is not in the skeleton"), x.w / sum)).ToArray();
+            if (r.Length > 1 && r[0].Item2 >= 0.999f) r = new[] { (r[0].Item1, 1f) };
+            if (r.Length == 1) r[0].Item2 = 1;
+            // HSD envelopes: weights in 1/10 steps (as the game's own bodies) keep the envelope list short
+            if (r.Length > 1)
+            {
+                for (int i = 0; i < r.Length; i++) r[i].Item2 = MathF.Round(r[i].Item2, 1);
+                r = r.Where(x => x.Item2 > 0).ToArray();
+                float s2 = r.Sum(x => x.Item2);
+                r[0].Item2 += 1 - s2;
+                if (r.Length == 1) r[0].Item2 = 1;
+            }
+            return r;
+        }
+
+        private static GX_Vertex Vertex(IOVertex v, Matrix4x4 inv, bool uv)
+        {
+            var p = Vector3.Transform(v.Position, inv);
+            var n = Vector3.Normalize(Vector3.TransformNormal(v.Normal, inv));
+            var g = new GX_Vertex { POS = new GXVector3(p.X, p.Y, p.Z), NRM = new GXVector3(n.X, n.Y, n.Z) };
+            if (uv && v.UVs.Count > 0)
+            {
+                // the glTF reader flips V (1 - v); HSD's UVs are the glTF's as the exporter writes them (ModelImporter's FlipUVs)
+                g.TEX0 = new GXVector2(v.UVs[0].X, 1 - v.UVs[0].Y);
+                g.TEX1 = g.TEX0;
+            }
+            return g;
+        }
+
+        /// <summary>World matrices of the exported template bones JOBJ_0..n-1.</summary>
+        private static Matrix4x4[] TemplateWorlds(IOModel exported, int count)
+        {
+            var w = new Matrix4x4[count];
+            var seen = new bool[count];
+            foreach (var b in exported.Skeleton.BreathFirstOrder())
+            {
+                var m = BoneName.Match(b.Name);
+                if (!m.Success || int.Parse(m.Groups[1].Value) >= count) throw new ImportError($"unexpected exported bone {b.Name}");
+                int i = int.Parse(m.Groups[1].Value);
+                w[i] = b.WorldTransform; seen[i] = true;
+            }
+            if (seen.Any(x => !x)) throw new ImportError("the exported template is missing bones");
+            return w;
+        }
+
+        /// <summary>The glb skeleton must be the template's: JOBJ_0..n-1, same parents. Reports the bind-pose drift.</summary>
+        private static void CheckSkeleton(IOModel model, int count, int[] parents, Matrix4x4[] worlds)
+        {
+            var found = new Dictionary<int, IOBone>();
+            void Walk(IOBone b, int parent)
+            {
+                int me = parent;
+                var m = BoneName.Match(b.Name);
+                if (m.Success)
+                {
+                    me = int.Parse(m.Groups[1].Value);
+                    if (me >= count) throw new ImportError($"bone {b.Name}: the template has only {count} joints (JOBJ_0..JOBJ_{count - 1}); new bones need --skeleton glb and a roles file (docs/MODDING.md)");
+                    if (found.ContainsKey(me)) throw new ImportError($"bone {b.Name} appears twice");
+                    found[me] = b;
+                    if (parents[me] != parent)
+                        throw new ImportError($"bone {b.Name}: parent is {(parent < 0 ? "none" : "JOBJ_" + parent)}, the template's is {(parents[me] < 0 ? "none" : "JOBJ_" + parents[me])}; the skeleton must stay the template's (or use --skeleton glb)");
+                }
+                else if (parent >= 0)
+                    throw new ImportError($"bone {b.Name} inside the skeleton: only JOBJ_n bones are allowed with the template skeleton (new bones: --skeleton glb)");
+                foreach (var c in b.Children) Walk(c, me);
+            }
+            foreach (var r in model.Skeleton.RootBones) Walk(r, -1);
+            if (found.Count != count)
+                throw new ImportError($"the glb has {found.Count} of the template's {count} bones (missing: " +
+                    string.Join(", ", Enumerable.Range(0, count).Where(i => !found.ContainsKey(i)).Take(10).Select(i => "JOBJ_" + i)) + "); use --skeleton glb to drop joints");
+            float drift = 0;
+            foreach (var (i, b) in found)
+                drift = Math.Max(drift, Vector3.Distance(b.WorldTransform.Translation, worlds[i].Translation));
+            Console.WriteLine($"import: skeleton matches the template ({count} joints); largest joint position difference {drift:G3}");
+        }
+
+        private static float ModelSize(IOModel m)
+        {
+            var all = m.Meshes.SelectMany(x => x.Vertices).Select(v => v.Position).ToList();
+            if (all.Count == 0) return 1;
+            var lo = all.Aggregate(Vector3.Min); var hi = all.Aggregate(Vector3.Max);
+            return Math.Max(Vector3.Distance(lo, hi), 1e-6f);
+        }
+
+        /// <summary>Same bounding box (within 0.1% of the model size) and same triangle count.</summary>
+        private static bool SameGeometry(IOMesh a, IOMesh b, float size, out string why)
+        {
+            int ta = a.Polygons.Sum(p => TriCount(p)), tb = b.Polygons.Sum(p => TriCount(p));
+            why = "";
+            if (ta != tb) { why = $"{ta} -> {tb} triangles"; return false; }
+            if (a.Vertices.Count == 0 || b.Vertices.Count == 0) return true;
+            var la = a.Vertices.Select(v => v.Position).Aggregate(Vector3.Min); var ha = a.Vertices.Select(v => v.Position).Aggregate(Vector3.Max);
+            var lb = b.Vertices.Select(v => v.Position).Aggregate(Vector3.Min); var hb = b.Vertices.Select(v => v.Position).Aggregate(Vector3.Max);
+            float d = Math.Max(Vector3.Distance(la, lb), Vector3.Distance(ha, hb));
+            if (d > size * 1e-3f) { why = $"bounding box moved by {d:G3}"; return false; }
+            return true;
+        }
+
+        private static int TriCount(IOPolygon p) => p.PrimitiveType switch
+        {
+            IOPrimitive.TRIANGLE => p.Indicies.Count / 3,
+            IOPrimitive.TRISTRIP or IOPrimitive.TRIFAN => Math.Max(0, p.Indicies.Count - 2),
+            _ => p.Indicies.Count / 3,
+        };
+
+        /// <summary>The TObj the glTF exporter wrote as the base colour texture: the last diffuse-lightmap TObj.</summary>
+        private static HSD_TOBJ BaseColourTObj(HSD_MOBJ mobj) =>
+            mobj.Textures?.List.LastOrDefault(t => t.DiffuseLightmap && t.ImageData?.ImageData != null);
+
+        private static bool ApplyTexture(Material mat, HSD_MOBJ mobj, string meshName)
+        {
+            var tex = mat.GetDiffuseTexture()?.PrimaryImage?.Content;
+            var tobj = BaseColourTObj(mobj);
+            if (tex == null || tobj == null || !tex.Value.IsPng) return false;
+            using var edited = SixLabors.ImageSharp.Image.Load<Bgra32>(tex.Value.Content.ToArray());
+            byte[] now = tobj.GetDecodedImageData();
+            int w = tobj.ImageData.Width, h = tobj.ImageData.Height;
+            var px = new byte[edited.Width * edited.Height * 4];
+            edited.CopyPixelDataTo(px);
+            if (edited.Width == w && edited.Height == h)
+            {
+                long changed = 0;
+                for (int i = 0; i < px.Length; i += 4)
+                    for (int c = 0; c < 4; c++)
+                        if (Math.Abs(px[i + c] - now[i + c]) > 8) { changed++; break; }
+                if (changed <= (long)w * h / 1000) return false;   // unchanged (PNG round trips are exact; allow noise)
+                Console.WriteLine($"import: texture of {mat.Name} ({w}x{h} {tobj.ImageData.Format}): {changed} of {w * h} pixels changed, re-encoded");
+            }
+            else
+                Console.WriteLine($"import: texture of {mat.Name}: {w}x{h} -> {edited.Width}x{edited.Height}, re-encoded as {tobj.ImageData.Format}");
+            if (tobj.ImageData.MaxLOD > 0 || tobj.ImageData.MipMap != 0)
+                Console.WriteLine($"import: warning: {mat.Name}: the template texture has mipmaps; only level 0 is written");
+            tobj.EncodeImageData(px, edited.Width, edited.Height, tobj.ImageData.Format,
+                tobj.TlutData != null ? tobj.TlutData.Format : GXTlutFmt.RGB5A3);
+            return true;
+        }
+
+        private static bool ApplyColour(Material mat, HSD_MOBJ mobj, string meshName)
+        {
+            var f = mat.GetDiffuseColor(Vector4.One);
+            var d = mobj.Material;
+            if (d == null) return false;
+            var was = new Vector4(d.DIF_R, d.DIF_G, d.DIF_B, d.DIF_A) / 255f;
+            if (Vector4.Distance(f, was) < 1.5f / 255f) return false;
+            byte B(float x) => (byte)Math.Clamp(MathF.Round(x * 255f), 0, 255);
+            d.DIF_R = B(f.X); d.DIF_G = B(f.Y); d.DIF_B = B(f.Z); d.DIF_A = B(f.W);
+            Console.WriteLine($"import: diffuse colour of {mat.Name}: {was} -> {f}");
+            return true;
+        }
+
+        private static bool IsPow2(int x) => x >= 8 && (x & (x - 1)) == 0;
+
+        /// <summary>A glb material for new geometry: its base colour image encoded once (shared by all its MObjs).</summary>
+        private static MatInfo Material(string name, ModelRoot gltf, HSD_MOBJ texTemplate, Dictionary<string, MatInfo> cache)
+        {
+            if (cache.TryGetValue(name, out var have)) return have;
+            var mat = gltf.LogicalMaterials.FirstOrDefault(x => x.Name == name);
+            var info = new MatInfo { Name = name, DoubleSided = mat?.DoubleSided ?? true, Colour = mat?.GetDiffuseColor(Vector4.One) ?? Vector4.One };
+            var tex = mat?.GetDiffuseTexture()?.PrimaryImage?.Content;
+            if (tex != null)
+            {
+                if (texTemplate == null) throw new ImportError($"material {name} has a texture but the template has no textured material to copy");
+                if (!tex.Value.IsPng) throw new ImportError($"material {name}: the texture must be PNG (export_image_format AUTO / PNG)");
+                using var img = SixLabors.ImageSharp.Image.Load<Bgra32>(tex.Value.Content.ToArray());
+                if (!IsPow2(img.Width) || !IsPow2(img.Height) || img.Width > 1024 || img.Height > 1024)
+                    throw new ImportError($"material {name}: texture {img.Width}x{img.Height}; use a power of two from 8 to 1024");
+                var px = new byte[img.Width * img.Height * 4];
+                img.CopyPixelDataTo(px);
+                var dt = BaseColourTObj(texTemplate);
+                info.Diffuse = Encode(px, img.Width, img.Height, dt);
+                var st = texTemplate.Textures.List.FirstOrDefault(t => t.SpecularLightmap && t.ImageData != null);
+                if (st != null)
+                {
+                    float metal = Metallic(mat);
+                    int sw = Math.Max(8, img.Width / 2), sh = Math.Max(8, img.Height / 2);
+                    var sp = new byte[sw * sh * 4];
+                    for (int y = 0; y < sh; y++)
+                        for (int x = 0; x < sw; x++)
+                        {
+                            float l = 0; int n = 0;
+                            for (int yy = y * img.Height / sh; yy < (y + 1) * img.Height / sh; yy++)
+                                for (int xx = x * img.Width / sw; xx < (x + 1) * img.Width / sw; xx++)
+                                {
+                                    int o = (yy * img.Width + xx) * 4;
+                                    l += (0.114f * px[o] + 0.587f * px[o + 1] + 0.299f * px[o + 2]); n++;
+                                }
+                            byte g = (byte)Math.Clamp(l / Math.Max(n, 1) * (0.25f + 0.75f * metal), 0, 255);
+                            int q = (y * sw + x) * 4;
+                            sp[q] = sp[q + 1] = sp[q + 2] = g; sp[q + 3] = 255;
+                        }
+                    info.Specular = Encode(sp, sw, sh, st);
+                }
+                Console.WriteLine($"import: new textured material {name}: {img.Width}x{img.Height} {info.Diffuse.Format}" +
+                    (info.Specular != null ? $", specular mask {info.Specular.Width}x{info.Specular.Height} (metallic {Metallic(mat):0.##})" : "") +
+                    $"{(info.DoubleSided ? ", two-sided" : "")}");
+            }
+            cache[name] = info;
+            return info;
+        }
+
+        private static float Metallic(Material mat)
+        {
+            var ch = mat?.FindChannel("MetallicRoughness");
+            if (ch == null) return 0;
+            try { return ch.Value.GetFactor("MetallicFactor"); } catch { return 0; }
+        }
+
+        private static HSD_Image Encode(byte[] bgra, int w, int h, HSD_TOBJ like)
+        {
+            var t = new HSD_TOBJ();
+            t.EncodeImageData(bgra, w, h, like.ImageData.Format, like.TlutData != null ? like.TlutData.Format : GXTlutFmt.RGB5A3);
+            if (like.TlutData != null) throw new ImportError("palette (CI) template textures are not supported for new materials");
+            return t.ImageData;
+        }
+
+        /// <summary>A copy of the template's textured MObj (every field) with this material's images.</summary>
+        private static HSD_MOBJ TexturedMobj(HSD_MOBJ template, MatInfo info)
+        {
+            var m = new HSD_MOBJ { _s = template._s.DeepClone() };
+            var dt = BaseColourTObj(m);
+            foreach (var t in m.Textures.List)
+            {
+                if (t._s == dt._s) t.ImageData = info.Diffuse;
+                else if (t.SpecularLightmap && info.Specular != null) t.ImageData = info.Specular;
+                else if (t.SpecularLightmap) t.ImageData = info.Diffuse;
+                else t.ImageData = info.Diffuse;   // other stages: our base image (no template pixels survive)
+            }
+            return m;
+        }
+
+        /// <summary>
+        /// Flat material for new geometry: the template's first material's render mode without textures (constant colour,
+        /// lighting and specular as the template has them), diffuse = glb base colour, ambient = 70% of it.
+        /// </summary>
+        private static HSD_MOBJ NewMaterial(string name, ModelRoot gltf, HSD_MOBJ template, Dictionary<string, HSD_MOBJ> cache)
+        {
+            name ??= "";
+            if (cache.TryGetValue(name, out var have)) return have;
+            var mat = gltf.LogicalMaterials.FirstOrDefault(x => x.Name == name);
+            var c = mat?.GetDiffuseColor(Vector4.One) ?? Vector4.One;
+            byte B(float x) => (byte)Math.Clamp(MathF.Round(x * 255f), 0, 255);
+            const RENDER_MODE texBits = RENDER_MODE.TEX0 | RENDER_MODE.TEX1 | RENDER_MODE.TEX2 | RENDER_MODE.TEX3 |
+                RENDER_MODE.TEX4 | RENDER_MODE.TEX5 | RENDER_MODE.TEX6 | RENDER_MODE.TEX7;
+            var rm = template != null ? template.RenderFlags & ~texBits & ~RENDER_MODE.XLU : RENDER_MODE.CONSTANT | RENDER_MODE.DIFFUSE;
+            rm |= RENDER_MODE.CONSTANT | RENDER_MODE.DIFFUSE;
+            var tm = template?.Material;
+            var mobj = new HSD_MOBJ
+            {
+                RenderFlags = rm,
+                Material = new HSD_Material
+                {
+                    DIF_R = B(c.X), DIF_G = B(c.Y), DIF_B = B(c.Z), DIF_A = 255,
+                    AMB_R = B(c.X * 0.7f), AMB_G = B(c.Y * 0.7f), AMB_B = B(c.Z * 0.7f), AMB_A = 255,
+                    SPC_R = tm?.SPC_R ?? 0, SPC_G = tm?.SPC_G ?? 0, SPC_B = tm?.SPC_B ?? 0, SPC_A = 255,
+                    Alpha = 1,
+                    Shininess = tm?.Shininess ?? 20,
+                },
+            };
+            cache[name] = mobj;
+            Console.WriteLine($"import: new material {name}: colour {B(c.X)},{B(c.Y)},{B(c.Z)} render mode {rm}");
+            return mobj;
+        }
+
+        /// <summary>
+        /// Joint flags: joints whose DObjs changed get HSDLib's DObj-derived flags (OPA / XLU, LIGHTING, SPECULAR,
+        /// ENVELOPE_MODEL; all cleared when no DObj is left); every joint gets the ROOT_OPA / ROOT_XLU / ROOT_TEXEDGE bits
+        /// HSDLib computes (added, never removed). All other bits (SKELETON, IK types, billboards, ...) stay the template's.
+        /// </summary>
+        private static void UpdateFlags(HSD_JOBJ root, List<Joint> joints, HashSet<HSDStruct> touched)
+        {
+            var before = joints.Select(j => j.J.Flags).ToArray();
+            root.UpdateFlags();
+            const JOBJ_FLAG dobjBits = JOBJ_FLAG.OPA | JOBJ_FLAG.XLU | JOBJ_FLAG.TEXEDGE | JOBJ_FLAG.LIGHTING |
+                JOBJ_FLAG.SPECULAR | JOBJ_FLAG.ENVELOPE_MODEL;
+            const JOBJ_FLAG rootBits = JOBJ_FLAG.ROOT_OPA | JOBJ_FLAG.ROOT_XLU | JOBJ_FLAG.ROOT_TEXEDGE;
+            for (int i = 0; i < joints.Count; i++)
+            {
+                var j = joints[i].J;
+                var now = j.Flags;
+                var f = before[i] | (now & rootBits);
+                if (touched.Contains(j._s) || joints[i].New)
+                    f = (f & ~dobjBits) | (j.Dobj != null ? now & dobjBits : 0);
+                j.Flags = f;
+                if (f != before[i]) Console.WriteLine($"import: JOBJ_{i} flags {before[i]} -> {f}");
+            }
+        }
+    }
+}
diff --git a/HSDRawViewer/ModelInfo.cs b/HSDRawViewer/ModelInfo.cs
new file mode 100644
